
import open3d as o3d
import numpy as np
import copy
import csv
from pathlib import Path

# RANSAC Plane Fitting --------------------------------------------------

# File paths
folder = Path(r"D:\captures_stop_and_go\forward")
preprocessed_folder = folder / "SOR"

# RANSAC parameters
# Unit: mm, consistent with Zivid PLY point clouds
distance_threshold = 3.0
ransac_n = 3
num_iterations = 2000

# Store fitted plane normals and results
plane_normals = []
plane_results = []


# Helper function: calculate angle between two plane normals
def calculate_normal_angle(normal1, normal2):

    # Normalize both vectors
    normal1 = normal1 / np.linalg.norm(normal1)
    normal2 = normal2 / np.linalg.norm(normal2)

    # Absolute value removes normal direction ambiguity
    cos_angle = np.abs(np.dot(normal1, normal2))

    # Avoid numerical errors
    cos_angle = np.clip(cos_angle, -1.0, 1.0)

    # Convert radians to degrees
    angle = np.degrees(np.arccos(cos_angle))

    return angle


# Fit a plane for each capture -----------------------------------------

for i in range(1, 5):

    ply_path = (
        preprocessed_folder / f"capture_{i:03d}_sor.ply"
    )

    if not ply_path.is_file():
        raise FileNotFoundError(ply_path)

    # Load original point cloud (before registration)
    pcd = o3d.io.read_point_cloud(str(ply_path))

    if pcd.is_empty():
        raise ValueError(f"Empty point cloud: {ply_path}")

    print(f"\n{'=' * 55}")
    print(f"Capture {i:03d}")
    print(f"Loaded: {ply_path.name}")
    print(f"Number of points: {len(pcd.points)}")

    # RANSAC plane segmentation
    plane_model, inliers = pcd.segment_plane(
        distance_threshold=distance_threshold,
        ransac_n=ransac_n,
        num_iterations=num_iterations
    )

    # Plane equation: ax + by + cz + d = 0
    a, b, c, d = plane_model

    # Calculate unit normal vector
    normal = np.array([a, b, c], dtype=np.float64)
    normal = normal / np.linalg.norm(normal)

    # Make normal direction consistent across captures
    # Here, positive Z direction is selected
    if normal[2] < 0:
        normal = -normal
        a, b, c, d = -np.array([a, b, c, d])

    plane_normals.append(normal)

    # Number and percentage of plane inliers
    num_inliers = len(inliers)
    inlier_ratio = num_inliers / len(pcd.points)

    # Calculate point-to-plane RMSE for RANSAC inliers
    plane_points = np.asarray(pcd.points)[inliers]

    distances = np.abs(
        plane_points @ normal + d
    )

    plane_rmse = np.sqrt(np.mean(distances ** 2))

    # Calculate angle relative to Capture 001
    if i == 1:
        angle_to_reference = 0.0
    else:
        angle_to_reference = calculate_normal_angle(
            plane_normals[0],
            normal
        )

    print("\nRANSAC Plane Fitting Results")

    print(
        f"Plane equation: "
        f"{a:.6f}x + {b:.6f}y + "
        f"{c:.6f}z + {d:.6f} = 0"
    )

    print(f"Plane normal: {normal}")

    print(f"Number of plane inliers: {num_inliers}")

    print(f"Inlier ratio: {inlier_ratio:.4f}")

    print(f"Plane fitting RMSE: {plane_rmse:.4f} mm")

    print(
        f"Normal angle to Capture 001: "
        f"{angle_to_reference:.6f} degrees"
    )

    # Save numerical results
    plane_results.append({
        "Capture": i,
        "Normal_X": normal[0],
        "Normal_Y": normal[1],
        "Normal_Z": normal[2],
        "Plane_d_mm": d,
        "Number_of_Inliers": num_inliers,
        "Inlier_Ratio": inlier_ratio,
        "Plane_RMSE_mm": plane_rmse,
        "Angle_to_Capture001_deg": angle_to_reference
    })

    # Visualization -----------------------------------------------------

    # RANSAC plane points: green
    plane_cloud = pcd.select_by_index(inliers)
    plane_cloud.paint_uniform_color([0, 1, 0])

    # Remaining points: red
    other_cloud = pcd.select_by_index(
        inliers, invert=True
    )
    other_cloud.paint_uniform_color([1, 0, 0])

    print(f"\nVisualizing RANSAC plane: Capture {i:03d}")

    o3d.visualization.draw_geometries(
        [plane_cloud, other_cloud],
        window_name=f"RANSAC Plane - Capture {i:03d}"
    )


# Summary ---------------------------------------------------------------

print("\n" + "=" * 55)
print("RANSAC Plane Fitting Summary")
print("=" * 55)

for result in plane_results:

    print(
        f"Capture {result['Capture']:03d} | "
        f"Normal: "
        f"({result['Normal_X']:.6f}, "
        f"{result['Normal_Y']:.6f}, "
        f"{result['Normal_Z']:.6f}) | "
        f"Angle: "
        f"{result['Angle_to_Capture001_deg']:.6f} deg"
    )


# Save results to CSV ---------------------------------------------------

output_path = folder / "ransac_plane_results.csv"

with open(
    output_path,
    mode="w",
    newline="",
    encoding="utf-8"
) as csvfile:

    writer = csv.DictWriter(
        csvfile,
        fieldnames=plane_results[0].keys()
    )

    writer.writeheader()
    writer.writerows(plane_results)

print(f"\nRANSAC results saved to: {output_path}")

print("\nRANSAC Plane Fitting completed!")
